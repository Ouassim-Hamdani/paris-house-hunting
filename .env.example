# =============================================================
#  Logement bot configuration
#  Copy this file to `.env` and fill in the values:
#     cp .env.example .env        (Linux / macOS)
#     Copy-Item .env.example .env (Windows PowerShell)
#  Never commit your real `.env` file.
# =============================================================

# --- Required --------------------------------------------------

# Telegram bot token, obtained from @BotFather (https://t.me/BotFather)
BOT=123456789:ABCDefghIJKlmNoPQRsTUVwxyZ

# Password users must send with /register <password> to use the bot
PASSWORD=change-me

# --- Optional --------------------------------------------------

# Path to the SQLite database file.
# Ignored under Docker: docker-compose forces /app/data/housing.sqlite3,
# which is mapped to ./data on the host.
SQLITE_PATH=data/housing.sqlite3

# Delay between two background scans, in seconds (default: 300 = 5 minutes)
SCAN_INTERVAL=300

# CROUS "tool" (campaign) ID (default: 47 = 2026-2027 campaign)
CROUS_TOOL_ID=47

